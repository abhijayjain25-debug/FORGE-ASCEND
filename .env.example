# ════════════════════════════════════════════════════
# FORGE — Environment Variables Template
# ════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The .env file is gitignored — NEVER commit secrets.
#
# For Vercel deployment, add these as Environment Variables
# in your Vercel Project Settings > Environment Variables.
# ════════════════════════════════════════════════════

# Supabase Project URL (from supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (safe to use client-side)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
